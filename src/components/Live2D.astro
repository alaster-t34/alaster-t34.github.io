<script>
import { createWidget } from 'l2d-widget'

declare global {
  interface Window {
    __alasterL2dLoaded?: boolean
  }
}

function initLive2D() {
  if (window.__alasterL2dLoaded) return

  try {
    createWidget({
      model: {
        path: 'https://raw.githubusercontent.com/zenghongtu/live2d-model-assets/master/assets/moc/girls-frontline/HK416-1/normal/model.json',
        scale: 1,
        volume: 0,
        logLevel: 'warn',
        tips: false,
      },
      position: 'bottom-right',
      size: {
        width: 360,
        height: 480,
      },
      primaryColor: 'rgba(56, 176, 222, 0.92)',
      transitionDuration: 900,
      transitionType: 'slide',
    })

    window.__alasterL2dLoaded = true
  } catch (error) {
    window.__alasterL2dLoaded = false
    console.error('[Live2D] Failed to initialize l2d-widget:', error)
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initLive2D, { once: true })
} else {
  initLive2D()
}
</script>
